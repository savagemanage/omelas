source "https://rubygems.org"

# Jekyll static site generator for the Omelasian Bible reading site.
# Pinned to the 4.x line, which matches the local build and the Actions deploy.
gem "jekyll", "~> 4.4"

# Plugins actually used by the site.
group :jekyll_plugins do
  gem "jekyll-sitemap"
end

# Keep Ruby 3.4 happy: a few stdlib gems were unbundled from the default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "webrick"
